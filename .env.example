# Required: free key from https://aistudio.google.com/apikey (Gemini Developer API)
GEMINI_API_KEY=
# Optional: any Gemini model that supports function calling (see ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: show the browser window while the agent works (true/false)
HEADED=false

# Optional: only needed to read issues from GitHub / post results / run the webhook
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=
TRIGGER_LABEL=RFQA

# Site to test when a ticket has no "Target URL:" line (optional).
DEFAULT_TARGET_URL=https://www.saucedemo.com
